                    "H2O",
                    "CH4",
                    "CO2",
                    "CO"
                  ]
                },
                "center_um": {
                  "type": "number"
                },
                "depth": {
                  "type": "number",
                  "description": "Fractional depth relative to continuum fit, 0..1"
                },
                "detected": {
                  "type": "boolean"
                }
              }
            }
          },
          "pipeline": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "AnalysisRequest": {
        "type": "object",
        "required": [
          "ra",
          "dec"
        ],
        "properties": {
          "ra": {
            "type": "number"
          },
          "dec": {
            "type": "number"
          },
          "size_px": {
            "type": "integer",
            "default": 64,
            "minimum": 16,
            "maximum": 256
          },
          "pixel_scale_arcsec": {
            "type": "number",
            "default": 6.2
          },
          "band": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 101
          },
          "epoch_1": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Epoch"
              }
            ],
            "default": "2026-Q1"
          },
          "epoch_2": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Epoch"
              }
            ],
            "default": "2026-Q3"
          },
          "rate_arcsec_yr": {
            "type": "number",
            "default": 0,
            "description": "shift-stack: apparent sky rate"
          },
          "pa_deg": {
            "type": "number",
            "default": 0,
            "description": "shift-stack: position angle of motion, deg east of north"
          },
          "n_frames": {
            "type": "integer",
            "default": 24,
            "minimum": 2,
            "maximum": 64
          },
          "combine": {
            "type": "string",
            "enum": [
              "mean",
              "median"
            ],
            "default": "mean"
          },
          "rate_range_arcsec_yr": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2,
            "default": [
              20,
              200
            ]
          },
          "pa_range_deg": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2,
            "default": [
              30,
              90
            ]
          },
          "grid": {
            "type": "integer",
            "default": 5,
            "minimum": 2,
            "maximum": 9
          }
        }
      },
      "Detection": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
