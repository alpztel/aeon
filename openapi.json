            "type": "integer"
          },
          "frame_times": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "rate_arcsec_yr": {
            "type": "number"
          },
          "pa_deg": {
            "type": "number"
          },
          "peak": {
            "$ref": "#/components/schemas/Detection"
