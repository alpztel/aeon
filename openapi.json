                  "type": "object",
                  "properties": {
                    "years": {
                      "type": "number"
                    },
                    "xyz_au": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    },
                    "ra": {
                      "type": "number"
                    },
                    "dec": {
                      "type": "number"
                    },
                    "distance_au": {
                      "type": "number"
                    },
                    "kepler_only_deviation_km": {
                      "type": "number"
                    }
                  }
                }
              },
              "orbit_ellipse": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "planets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "trajectory": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StateSample"
                  }
                }
              }
            }
          },
          "energy_error": {
            "type": "number"
          },
          "input": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "StateSample": {
        "type": "object",
        "required": [
          "t",
          "x",
          "y",
          "z"
