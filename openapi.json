              "rates_arcsec_yr": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "pas_deg": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "grid": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      },
