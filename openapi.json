              },
              "period_years": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "trajectory": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/StateSample"
                }
              },
              "horizons": {
                "type": "array",
