{
  "openapi": "3.1.0",
  "info": {
    "title": "AEON Astrophysical OS API",
    "version": "1.0.0",
    "description": "Frozen data contract shared by every AEON service. 11 paths. Owners: core = /backend (FastAPI, Astropy, Photutils, REBOUND, DuckDB); ai = /ai-engine; missions = /multi-mission-api. All services are mounted behind one Nginx gateway under /api/v1. Changing this file requires a PR reviewed by the repo lead (@alpztel).",
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "https://api.aeon.tech",
      "description": "Production gateway (DigitalOcean, Nginx)"
    },
    {
      "url": "http://localhost:8000",
      "description": "Local core backend"
    }
  ],
  "tags": [
    {
      "name": "core",
      "description": "Owned by /backend"
    },
    {
      "name": "ai",
      "description": "Owned by /ai-engine"
    },
    {
      "name": "missions",
      "description": "Owned by /multi-mission-api"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "core"
        ],
        "operationId": "getHealth",
        "summary": "Service health and engine availability",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/search": {
      "get": {
        "tags": [
          "core"
        ],
        "operationId": "searchCatalog",
        "summary": "Name resolution or cone search over the DuckDB catalog",
        "description": "Provide either `q` (name / designation / id, case-insensitive) or `ra`+`dec` (+ `radius_arcmin`). Field sources from the sky model are appended when `include_field=true`.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ra",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 360
            }
          },
          {
            "name": "dec",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "name": "radius_arcmin",
            "in": "query",
            "schema": {
              "type": "number",
              "default": 10,
              "minimum": 0.01,
              "maximum": 180
            }
          },
          {
            "name": "include_field",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "minimum": 1,
              "maximum": 500
            }
          },
          {
            "name": "epoch",
            "in": "query",
            "description": "Positions are propagated to this epoch; default is mid-survey 2026.5",
            "schema": {
              "$ref": "#/components/schemas/Epoch"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matches ordered by separation (cone) or relevance (name)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/v1/sky/cutout": {
      "get": {
        "tags": [
          "core"
        ],
        "operationId": "getCutout",
        "summary": "Calibrated image cutout (FITS pipeline) at one epoch and band",
        "parameters": [
          {
            "name": "ra",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "dec",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "epoch",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Epoch"
            }
          },
          {
            "name": "size_px",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 64,
              "minimum": 16,
              "maximum": 256
            }
          },
          {
            "name": "pixel_scale_arcsec",
            "in": "query",
            "schema": {
              "type": "number",
              "default": 6.2,
              "minimum": 0.5,
              "maximum": 30
            }
          },
          {
            "name": "band",
            "in": "query",
            "description": "Band index 0..101, or omitted for the broadband (all-band mean) image",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 101
            }
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "fits"
              ],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Image as JSON (row-major float array, row 0 = south) or as a FITS file with WCS header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Image"
                }
              },
              "application/fits": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/spectrum": {
      "get": {
        "tags": [
          "core"
        ],
        "operationId": "getSpectrum",
        "summary": "102-band SPHEREx-like spectrum (0.75-5.0 um) by aperture photometry on a spectral cube",
        "parameters": [
          {
            "name": "ra",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "dec",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "epoch",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Epoch"
            }
          },
          {
            "name": "aperture_arcsec",
            "in": "query",
            "schema": {
              "type": "number",
              "default": 9.3
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Spectrum",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Spectrum"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analysis/{method}": {
      "post": {
        "tags": [
          "core"
        ],
        "operationId": "runAnalysis",
        "summary": "Image analysis: difference imaging, shift-and-stack, or blind 5x5 velocity grid search",
        "parameters": [
          {
            "name": "method",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "difference",
                "shift-stack",
                "blind-search"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result; shape depends on method",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/DifferenceResult"
                    },
                    {
                      "$ref": "#/components/schemas/ShiftStackResult"
                    },
                    {
                      "$ref": "#/components/schemas/BlindSearchResult"
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/v1/orbit/simulate": {
      "post": {
        "tags": [
          "core"
        ],
        "operationId": "simulateOrbit",
        "summary": "REBOUND N-body forecast (Sun + Jupiter, Saturn, Uranus, Neptune + test particle)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrbitRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Trajectories in heliocentric ecliptic J2000, AU",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrbitResult"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/v1/ai/command": {
      "post": {
        "tags": [
          "ai"
        ],
        "operationId": "aiCommand",
        "summary": "Astro-LLM: natural language (TR/EN) to UI actions via function calling",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "lang": {
                    "$ref": "#/components/schemas/Lang"
                  },
                  "context": {
                    "type": "object",
                    "description": "Current UI state: ra, dec, epoch, selected target, active modes",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reply text plus ordered UI actions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "reply",
                    "actions"
                  ],
                  "properties": {
                    "reply": {
                      "type": "string"
                    },
                    "lang": {
                      "$ref": "#/components/schemas/Lang"
                    },
                    "actions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/UiAction"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/classify": {
      "post": {
        "tags": [
          "ai"
        ],
        "operationId": "aiClassify",
        "summary": "1D-CNN spectral classifier (5 classes) and PatchAnomalyViT image anomaly score",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "flux_ujy": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 102,
                    "maxItems": 102
                  },
                  "image": {
                    "$ref": "#/components/schemas/Image"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Class probabilities and anomaly score",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "probabilities": {
                      "type": "object",
                      "propertyNames": {
                        "$ref": "#/components/schemas/ObjectClass"
                      },
                      "additionalProperties": {
                        "type": "number"
                      }
                    },
                    "top_class": {
                      "$ref": "#/components/schemas/ObjectClass"
                    },
                    "anomaly_score": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "model_versions": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/missions/crossmatch": {
      "get": {
        "tags": [
          "missions"
        ],
        "operationId": "missionsCrossmatch",
        "summary": "Gaia DR3 + WISE cross-match, full SED (0.4-22 um) and MAST JWST/HST overlap",
        "parameters": [
          {
            "name": "ra",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "dec",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "radius_arcsec",
            "in": "query",
            "schema": {
              "type": "number",
              "default": 6
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matches",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "gaia": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "wise": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "sed": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "wavelength_um",
                          "flux_ujy"
                        ],
                        "properties": {
                          "wavelength_um": {
                            "type": "number"
                          },
                          "flux_ujy": {
                            "type": "number"
                          },
                          "flux_err_ujy": {
                            "type": "number"
                          },
                          "survey": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "unmatched_ir_candidate": {
                      "type": "boolean"
                    },
                    "mast_overlap": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "mission": {
                            "type": "string",
                            "enum": [
                              "JWST",
                              "HST"
                            ]
                          },
                          "obs_id": {
                            "type": "string"
                          },
                          "instrument": {
                            "type": "string"
                          },
                          "filter": {
                            "type": "string"
                          },
                          "preview_url": {
                            "type": "string",
                            "format": "uri"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/alerts/gcn": {
      "get": {
        "tags": [
          "missions"
        ],
        "operationId": "gcnAlerts",
        "summary": "Recent NASA GCN notices (GRB, supernova, neutrino) for the ticker",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Alerts, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "kind",
                      "time_utc"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "kind": {
                        "type": "string"
                      },
                      "time_utc": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "ra": {
                        "type": "number"
                      },
                      "dec": {
                        "type": "number"
                      },
                      "error_radius_deg": {
                        "type": "number"
                      },
                      "title": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string",
                        "format": "uri"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/candidates": {
      "get": {
        "tags": [
          "missions"
        ],
        "operationId": "listCandidates",
        "summary": "Citizen-science candidate pool / leaderboard (MongoDB Atlas)",
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "votes",
                "recent",
                "anomaly"
              ],
              "default": "votes"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Candidates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Candidate"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "missions"
        ],
        "operationId": "submitCandidate",
        "summary": "Submit a new candidate or vote on an existing one; high-confidence submissions open a GitHub Issue",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "submit",
                      "vote"
                    ]
                  },
                  "candidate_id": {
                    "type": "string"
                  },
                  "candidate": {
                    "$ref": "#/components/schemas/Candidate"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored candidate",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Candidate"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "ValidationError": {
        "description": "Invalid parameters",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "detail": {}
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Lang": {
        "type": "string",
        "enum": [
          "tr",
          "en"
        ],
        "default": "en"
      },
      "Epoch": {
        "type": "string",
        "enum": [
          "2026-Q1",
          "2026-Q2",
          "2026-Q3",
          "2026-Q4"
        ],
        "default": "2026-Q1",
        "description": "Survey quarter; mid-quarter decimal years 2026.125 / .375 / .625 / .875"
      },
      "ObjectClass": {
        "type": "string",
        "enum": [
          "cold_brown_dwarf",
          "planet_x_candidate",
          "young_variable_star",
          "main_sequence_star",
          "high_z_galaxy"
        ]
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "version",
          "engines"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "version": {
            "type": "string"
          },
          "data_mode": {
            "type": "string",
            "enum": [
              "fits_archive",
              "physical_model"
            ],
            "description": "fits_archive = real FITS files found in AEON_DATA_DIR; physical_model = scientific fallback renderer"
          },
          "engines": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "CatalogObject": {
        "type": "object",
        "required": [
          "id",
          "name",
          "ra",
          "dec",
          "object_class"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ra": {
            "type": "number"
          },
          "dec": {
            "type": "number"
          },
          "object_class": {
            "$ref": "#/components/schemas/ObjectClass"
          },
          "mag_ab_w2": {
            "type": [
              "number",
              "null"
            ],
            "description": "AB magnitude near 4.6 um"
          },
          "pm_ra_cosdec_arcsec_yr": {
            "type": "number"
          },
          "pm_dec_arcsec_yr": {
            "type": "number"
          },
          "distance_au": {
            "type": [
              "number",
              "null"
            ]
          },
          "distance_pc": {
            "type": [
              "number",
              "null"
            ]
          },
          "teff_k": {
            "type": [
              "number",
              "null"
            ]
          },
          "is_demo": {
            "type": "boolean"
          },
          "is_synthetic": {
            "type": "boolean",
            "description": "True for injected test objects that do not exist on the sky"
          },
          "description": {
            "type": "object",
            "properties": {
              "tr": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            }
          },
          "separation_arcsec": {
            "type": [
              "number",
              "null"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "catalog",
              "field"
            ]
          }
        }
      },
      "CatalogResponse": {
        "type": "object",
        "required": [
          "count",
          "results"
        ],
        "properties": {
          "query": {
            "type": "object",
            "additionalProperties": true
          },
          "count": {
            "type": "integer"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogObject"
            }
          }
        }
      },
      "Image": {
        "type": "object",
        "required": [
          "width",
          "height",
          "data"
        ],
        "properties": {
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "Row-major, length width*height, row 0 = south edge, column 0 = east edge (sky orientation, north up / east left). Units uJy/pixel unless stated."
          },
          "unit": {
            "type": "string"
          },
          "epoch": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Epoch"
              },
              {
                "type": "null"
              }
            ],
            "description": "null for derived images (difference, stack)"
          },
          "ra": {
            "type": "number"
          },
          "dec": {
            "type": "number"
          },
          "pixel_scale_arcsec": {
            "type": "number"
          },
          "band": {
            "type": [
              "integer",
              "null"
            ]
          },
          "wcs": {
            "type": "object",
            "additionalProperties": true,
            "description": "FITS WCS keywords (CTYPE, CRVAL, CRPIX, CDELT)"
          },
          "stats": {
            "type": "object",
            "properties": {
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "median": {
                "type": "number"
              },
              "std": {
                "type": "number"
              }
            }
          },
          "data_mode": {
            "type": "string",
            "enum": [
              "fits_archive",
              "physical_model"
            ]
          },
          "background": {
            "type": "object",
            "properties": {
              "level": {
                "type": "number"
              },
              "std": {
                "type": "number"
              }
            }
          }
        }
      },
      "Spectrum": {
        "type": "object",
        "required": [
          "wavelength_um",
          "flux_ujy",
          "flux_err_ujy"
        ],
        "properties": {
          "ra": {
            "type": "number"
          },
          "dec": {
            "type": "number"
          },
          "epoch": {
            "$ref": "#/components/schemas/Epoch"
          },
          "wavelength_um": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 102,
            "maxItems": 102
          },
          "bandwidth_um": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 102,
            "maxItems": 102
          },
          "flux_ujy": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 102,
            "maxItems": 102
          },
          "flux_err_ujy": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 102,
            "maxItems": 102
          },
          "snr_median": {
            "type": "number"
          },
          "matched_object": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CatalogObject"
              },
              {
                "type": "null"
              }
