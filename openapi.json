                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 1
              },
              "inc_deg": {
                "type": "number"
              },
              "Omega_deg": {
                "type": "number",
                "default": 0
              },
              "omega_deg": {
                "type": "number",
                "default": 0
