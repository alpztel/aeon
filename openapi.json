      },
      "ShiftStackResult": {
        "type": "object",
        "required": [
          "method",
          "stacked",
          "snr_stacked"
        ],
        "properties": {
          "method": {
            "const": "shift-stack"
          },
          "stacked": {
            "$ref": "#/components/schemas/Image"
          },
          "single_frame": {
            "$ref": "#/components/schemas/Image"
          },
