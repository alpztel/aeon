              "ra": {
                "type": "number"
              },
              "dec": {
                "type": "number"
              },
              "distance_au": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "rate_arcsec_yr": {
                "type": "number",
                "default": 0
              },
              "pa_deg": {
                "type": "number",
                "default": 0
