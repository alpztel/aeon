            "type": "array",
            "items": {
              "type": "number"
            },
            "default": [
              1,
              5,
              10
            ]
          },
          "samples_per_year": {
            "type": "integer",
            "default": 24,
            "minimum": 1,
            "maximum": 365
          }
        }
      },
      "OrbitResult": {
        "type": "object",
        "required": [
          "engine",
          "frame",
          "particle",
          "planets"
        ],
        "properties": {
          "engine": {
            "type": "string",
            "description": "e.g. rebound-4.x/ias15 or numpy-leapfrog"
