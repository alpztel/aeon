      "BlindSearchResult": {
        "type": "object",
        "required": [
          "method",
          "best",
          "grid"
        ],
        "properties": {
          "method": {
            "const": "blind-search"
          },
          "rates_arcsec_yr": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "pas_deg": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "grid": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "description": "S/N, indexed [rate_index][pa_index]"
